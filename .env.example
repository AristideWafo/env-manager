# Copy to .env (docker compose --env-file .env) or export manually for local runs.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=envmanager.ffaero.com

# Fernet key for encrypting secret variables at rest. MUST stay outside the DB.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENV_MANAGER_FERNET_KEY=

WEBAUTHN_RP_ID=envmanager.ffaero.com
WEBAUTHN_ORIGIN=https://envmanager.ffaero.com

# Comma-separated bearer tokens for the CI/CD lock/unlock routes only.
CI_API_TOKENS=

# Host path mounted into the container and matching your AllowedRoot rows.
FFAERO_ROOT=/opt/ffaero
