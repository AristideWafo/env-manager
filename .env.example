# Copy to .env (docker compose --env-file .env) or pass as env vars to `docker run`.

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated list of hostnames this instance is served on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Secrets encryption --------------------------------------------------------
# Fernet key for encrypting secret variables at rest. MUST stay outside the DB.
# Optional: leave empty and one is auto-generated on first boot, persisted next
# to the SQLite file inside the `db-data` volume (survives restarts/upgrades).
# Set this explicitly if you'd rather manage it via your own secret store, or
# to restore a previous key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENV_MANAGER_FERNET_KEY=

# Path to the SQLite file inside the container (matches the `db-data` volume
# mount in docker-compose.yml; only change this if you edit the volume mount too).
ENV_MANAGER_DB_PATH=/app/data/db.sqlite3

# --- WebAuthn (passkeys) -------------------------------------------------------
# Hostname passkeys are registered against (requires HTTPS, or "localhost" for dev).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Env Manager
# Full HTTPS origin serving this app (must match WEBAUTHN_RP_ID's scheme+host).
WEBAUTHN_ORIGIN=http://localhost:8000

# --- CI/CD integration (optional) -----------------------------------------------
# Only needed if a pipeline calls the lock/unlock API (see API_CONTRACT.md).
# Comma-separated bearer tokens for those routes; leave empty if unused.
CI_API_TOKENS=

# --- Docker Compose only ---------------------------------------------------------
# Set to a published image (e.g. ghcr.io/aristidewafo/env-manager:latest) to skip
# building locally; leave unset to use the local `build: .` image.
ENV_MANAGER_IMAGE=

# Host path mounted into the container; must match the AllowedRoot rows you
# declare in-app. The container-side path can be changed via PROJECTS_ROOT_CONTAINER.
PROJECTS_ROOT=./data/projects
PROJECTS_ROOT_CONTAINER=/data/projects
